generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  RUNNING
  COMPLETED
}

enum Verdict {
  AC
  WA
  CE
  RE
  TLE
}

enum Language {
  JAVA
  CPP
}

enum ProblemRequestStatus{
  PENDING
  APPROVED
  REJECTED
  IN_REVIEW
}

enum JudgeMode {
  STDIN
  FUNCTION
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String
  role             UserRole          @default(USER)
  submissions      Submission[]
  leaderboardEntry LeaderboardEntry?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  problemRequests  ProblemRequest[] @relation("SubmittedRequests")
  reviewedRequests ProblemRequest[] @relation("ReviewedRequests")
}

model Problem {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  statement     String       @db.Text
  inputFormat   String       @db.Text
  outputFormat  String       @db.Text
  constraints   String       @db.Text
  difficulty    Difficulty
  timeLimitMs   Int          @default(2000)
  memoryLimitMb Int          @default(256)
  judgeMode     JudgeMode    @default(STDIN)
  functionName  String       @default("solve")
  argumentTypes String       @default("")
  returnType    String       @default("int")
  testCases     TestCase[]
  submissions   Submission[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([difficulty, createdAt])
}

model TestCase {
  id        String   @id @default(cuid())
  problemId String
  input     String   @db.Text
  expected  String   @db.Text
  isHidden  Boolean  @default(true)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([problemId])
}

model Submission {
  id              String           @id @default(cuid())
  userId          String
  problemId       String
  language        Language
  sourceCode      String
  status          SubmissionStatus @default(PENDING)
  verdict         Verdict?
  passedTests     Int              @default(0)
  totalTests      Int              @default(0)
  executionTimeMs Int?
  errorMessage    String?
  failedTestInput String?
  expectedOutput  String?
  actualOutput    String?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem         Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, updatedAt])
  @@index([userId, problemId])
  @@index([problemId])
  @@index([userId, createdAt])
  @@index([verdict])
}

model LeaderboardEntry {
  id             String   @id @default(cuid())
  userId         String   @unique
  solvedCount    Int      @default(0)
  totalAccepted  Int      @default(0)
  totalSubmitted Int      @default(0)
  score          Int      @default(0)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([score, solvedCount])
}

model ProblemRequest {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation("SubmittedRequests", fields: [userId], references: [id], onDelete: Cascade)
  
  title        String
  statement    String                @db.Text
  inputFormat  String                @db.Text
  outputFormat String                @db.Text
  constraints  String                @db.Text
  difficulty   Difficulty            

  status       ProblemRequestStatus  @default(PENDING)
  adminNotes   String?               @db.Text 
  reviewedById String?               
  reviewedBy   User?                 @relation("ReviewedRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([userId])
  @@index([status])
  @@index([reviewedById])
}
